<Window x:Class="FO4RecordEditor.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="560" Width="540" Background="#1E1E1E" Foreground="#D4D4D4"
        WindowStartupLocation="CenterOwner">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="20">
    <TextBlock Text="AI Provider" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <ComboBox x:Name="ProviderBox" SelectionChanged="ProviderBox_SelectionChanged">
      <ComboBoxItem Content="Anthropic API" Tag="anthropic"/>
      <ComboBoxItem Content="Claude Code (local CLI — no API key)" Tag="claudecode"/>
      <ComboBoxItem Content="Ollama (local)" Tag="ollama"/>
    </ComboBox>

    <StackPanel x:Name="ModelPanel">
      <TextBlock Text="Model" FontWeight="SemiBold" Margin="0,14,0,4"/>
      <ComboBox x:Name="ModelBox" IsEditable="True">
        <ComboBoxItem Content="claude-opus-4-8"/>
        <ComboBoxItem Content="claude-sonnet-4-6"/>
        <ComboBoxItem Content="claude-haiku-4-5-20251001"/>
        <ComboBoxItem Content="claude-opus-4-1-20250805"/>
        <ComboBoxItem Content="claude-opus-4-20250514"/>
        <ComboBoxItem Content="claude-sonnet-4-20250514"/>
        <ComboBoxItem Content="claude-3-7-sonnet-20250219"/>
        <ComboBoxItem Content="claude-3-5-sonnet-20241022"/>
        <ComboBoxItem Content="claude-3-5-haiku-20241022"/>
        <ComboBoxItem Content="claude-3-opus-20240229"/>
        <ComboBoxItem Content="claude-3-haiku-20240307"/>
        <ComboBoxItem Content="opus"/>
        <ComboBoxItem Content="sonnet"/>
        <ComboBoxItem Content="haiku"/>
      </ComboBox>
      <TextBlock Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                 Text="Anthropic: use a full model id. Claude Code: 'opus' / 'sonnet' / 'haiku' or a full id."/>
    </StackPanel>

    <StackPanel x:Name="AnthropicPanel">
      <TextBlock Text="Anthropic API Key" Margin="0,14,0,4"/>
      <PasswordBox x:Name="ApiKeyBox" Background="#252526" Foreground="#D4D4D4"/>
      <TextBlock Text="Full tool-use (the AI reads your loaded plugins) is available on this provider."
                 Foreground="#7FB37F" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>

    <StackPanel x:Name="ClaudeCodePanel" Visibility="Collapsed">
      <TextBlock Text="Claude Code CLI path" Margin="0,14,0,4"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="ClaudeCodePathBox" Grid.Column="0" Background="#252526" Foreground="#D4D4D4"/>
        <Button x:Name="TestClaudeBtn" Grid.Column="1" Content="Test" Click="TestClaude_Click" Margin="6,0,0,0" Padding="12,2"/>
      </Grid>
      <TextBlock x:Name="ClaudeStatus" Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                 Text="Uses your Claude Code sign-in — no API key needed. Leave as 'claude' if it is on your PATH."/>
    </StackPanel>

    <StackPanel x:Name="OllamaPanel" Visibility="Collapsed">
      <TextBlock Text="Ollama URL" Margin="0,14,0,4"/>
      <TextBox x:Name="OllamaUrlBox" Background="#252526" Foreground="#D4D4D4"/>
      <TextBlock Text="Ollama Model" Margin="0,10,0,4"/>
      <TextBox x:Name="OllamaModelBox" Background="#252526" Foreground="#D4D4D4"/>
    </StackPanel>

    <TextBlock Text="Output Folder (AI-authored plugins)" FontWeight="SemiBold" Margin="0,16,0,4"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox x:Name="OutputFolderBox" Grid.Column="0" Background="#252526" Foreground="#D4D4D4"/>
      <Button x:Name="BrowseOutputBtn" Grid.Column="1" Content="Browse" Click="BrowseOutput_Click" Margin="6,0,0,0" Padding="12,2"/>
    </Grid>
    <TextBlock Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
               Text="Where save_plugin writes. Leave blank to use the app's Output folder."/>

    <TextBlock Text="Game Data Folder (Load Env)" FontWeight="SemiBold" Margin="0,16,0,4"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox x:Name="DataFolderBox" Grid.Column="0" Background="#252526" Foreground="#D4D4D4"/>
      <Button x:Name="BrowseDataBtn" Grid.Column="1" Content="Browse" Click="BrowseData_Click" Margin="6,0,0,0" Padding="12,2"/>
    </Grid>
    <TextBlock Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
               Text="The Data folder Load Env reads plugins from. Leave blank to auto-detect (this is correct when running through MO2's virtual file system). Set it to point at a specific Data folder when running outside MO2."/>

    <Button Content="Save" Click="Save_Click" Margin="0,20,0,0" Padding="20,6" HorizontalAlignment="Right"/>
  </StackPanel>
  </ScrollViewer>
</Window>
